        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_5">
          <ui:LogMessage DisplayName="Log start of per-student processing" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; (&quot;Processing all &quot; &amp; studentRows.Rows.Count.ToString() &amp; &quot; students in class &quot; &amp; in_Class.Name &amp; &quot;.&quot;)]" />
          <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" DisplayName="Process each student" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[studentRows.Rows]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="sd:DataRow">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="sd:DataRow" Name="studentRow" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Process one student" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <TryCatch DisplayName="Process student and continue on student error" sap2010:WorkflowViewState.IdRef="TryCatch_1">
                    <TryCatch.Try>
                      <Sequence DisplayName="Try processing student" sap2010:WorkflowViewState.IdRef="Sequence_1">
                        <ui:LogMessage DisplayName="Log student processing start" Level="Info" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; &quot;START Student &quot; &amp; studentRow(&quot;StudentId&quot;).ToString() &amp; &quot; - &quot; &amp; studentRow(&quot;StudentName&quot;).ToString()]" sap2010:WorkflowViewState.IdRef="LogMessage_5" /><ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Process one student" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Main\ProcessClass\ProcessStudent.xaml">
                          <ui:InvokeWorkflowFile.Arguments>
<InArgument x:TypeArguments="l:Subject" x:Key="in_Subject">[in_Subject]</InArgument>
<InArgument x:TypeArguments="l:Class" x:Key="in_Class">[in_Class]</InArgument>
                            <InArgument x:TypeArguments="x:String" x:Key="in_PersistenceFolder">[in_PersistenceFolder]</InArgument>
                            <InArgument x:TypeArguments="sd:DataRow" x:Key="in_StudentRow">[studentRow]</InArgument>
                            <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Saved">[saved]</OutArgument>
                          </ui:InvokeWorkflowFile.Arguments>
                        </ui:InvokeWorkflowFile>
                        <Assign DisplayName="Count students written to disk" sap2010:WorkflowViewState.IdRef="Assign_1">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Int32">[savedCount]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Int32">[savedCount + If(saved, 1, 0)]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </TryCatch.Try>
                    <TryCatch.Catches>
                      <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
                        <ActivityAction x:TypeArguments="s:Exception">
                          <ActivityAction.Argument>
