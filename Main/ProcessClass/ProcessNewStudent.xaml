  <Sequence DisplayName="New student: save only if Opgjort absence is a violation" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="l:ClassStudent" Name="student" />
      <Variable x:TypeArguments="x:Boolean" Name="isViolation" />
    </Sequence.Variables>
    <ui:InvokeCode DisplayName="Parse Opgjort Procent/Moduler and apply the new-student rules" Language="VBNet" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Code="Dim percent As Single = LOK2239.AbsenceRules.ParsePercent(in_StudentRow(&quot;OpgjortProcent&quot;).ToString())&#xA;Dim moduleCount As Integer = LOK2239.AbsenceRules.ParseModuleCount(in_StudentRow(&quot;OpgjortModuler&quot;).ToString())&#xA;out_IsViolation = LOK2239.AbsenceRules.IsNewStudentViolation(percent, moduleCount)&#xA;out_Student = New LOK2239.ClassStudent With {.Id = in_StudentRow(&quot;StudentId&quot;).ToString(), .ClassShortName = in_ClassShortName, .Name = in_StudentRow(&quot;StudentName&quot;).ToString(), .CurrentPercentage = percent, .ModuleCountSincePeriodStart = moduleCount}">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataRow" x:Key="in_StudentRow">[in_StudentRow]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_ClassShortName">[in_Class.Name]</InArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsViolation">[isViolation]</OutArgument>
        <OutArgument x:TypeArguments="l:ClassStudent" x:Key="out_Student">[student]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <If DisplayName="Absence &gt; 25% (or &gt;= 80% with 5 modules or fewer)?" Condition="[isViolation]" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:InvokeWorkflowFile DisplayName="Write student JSON" WorkflowFileName="Main\ProcessClass\SaveClassStudent.xaml" UnSafe="False" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
            <ui:InvokeWorkflowFile.Arguments>
<InArgument x:TypeArguments="l:Subject" x:Key="in_Subject">[in_Subject]</InArgument>
<InArgument x:TypeArguments="l:Class" x:Key="in_Class">[in_Class]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_PersistenceFolder">[in_PersistenceFolder]</InArgument>
              <InArgument x:TypeArguments="l:ClassStudent" x:Key="in_Student">[student]</InArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:LogMessage DisplayName="Log student now in the system" Level="Info" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; (LOK2239.AbsenceRules.Timestamp() &amp; &quot;&gt; Student &quot; &amp; student.Name &amp; &quot; (&quot; &amp; student.Id &amp; &quot;) is now in the system since absence from start of school year is &gt; 25% (&quot; &amp; student.CurrentPercentage.ToString(&quot;0.0&quot;, System.Globalization.CultureInfo.InvariantCulture) &amp; &quot;% for &quot; &amp; student.ModuleCountSincePeriodStart.ToString() &amp; &quot; modules).&quot;)]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
          <Assign DisplayName="Mark student as saved" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[out_Saved]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
