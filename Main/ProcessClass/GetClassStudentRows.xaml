<Sequence DisplayName="Identify all students in the class" sap2010:WorkflowViewState.IdRef="Sequence_1">
<ui:LogMessage DisplayName="Log student identity extraction" Level="Info" Message="[&quot;Identifying all students in the extracted absence table.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
<ui:InvokeCode DisplayName="Build distinct student rows" Language="VBNet" Code="Dim result As New System.Data.DataTable()&#xA;For Each col In New String() {&quot;StudentId&quot;, &quot;StudentName&quot;, &quot;OpgjortProcent&quot;, &quot;OpgjortModuler&quot;}&#xA;    result.Columns.Add(col, GetType(String))&#xA;Next&#xA;out_StudentRows = result&#xA;If in_Table Is Nothing OrElse in_Table.Rows.Count = 0 Then Return&#xA;For Each col In New String() {&quot;StudentName&quot;, &quot;StudentUrl&quot;, &quot;OpgjortProcent&quot;, &quot;OpgjortModuler&quot;}&#xA;    If Not in_Table.Columns.Contains(col) Then Throw New InvalidOperationException(&quot;Absence extraction is missing column &quot; &amp; col)&#xA;Next&#xA;Dim seen As New System.Collections.Generic.HashSet(Of String)(StringComparer.Ordinal)&#xA;For Each row As System.Data.DataRow In in_Table.Rows&#xA;    Dim url = System.Net.WebUtility.HtmlDecode(row(&quot;StudentUrl&quot;).ToString()).Trim()&#xA;    If url.Length = 0 Then Continue For&#xA;    Dim name = System.Net.WebUtility.HtmlDecode(row(&quot;StudentName&quot;).ToString()).Trim()&#xA;    Dim match = System.Text.RegularExpressions.Regex.Match(url, &quot;[?&amp;]elevid=(\d+)(&amp;|$)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;    If Not match.Success OrElse name.Length = 0 Then Throw New InvalidOperationException(&quot;Invalid student identity in absence table: &quot; &amp; name)&#xA;    Dim studentId = match.Groups(1).Value&#xA;    If seen.Add(studentId) Then result.Rows.Add(studentId, name, row(&quot;OpgjortProcent&quot;).ToString(), row(&quot;OpgjortModuler&quot;).ToString())&#xA;Next" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
