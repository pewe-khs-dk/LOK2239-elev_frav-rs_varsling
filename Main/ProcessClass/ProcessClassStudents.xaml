    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Identify distinct class students" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Main\ProcessClass\GetClassStudentRows.xaml">
      <ui:InvokeWorkflowFile.Arguments>
<InArgument x:TypeArguments="l:Subject" x:Key="in_Subject">[in_Subject]</InArgument>
<InArgument x:TypeArguments="l:Class" x:Key="in_Class">[in_Class]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_AbsenceTable">[in_AbsenceTable]</InArgument>
