    </ui:InvokeWorkflowFile>
    <If Condition="[studentRows.Rows.Count = 0]" DisplayName="Class has students" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
