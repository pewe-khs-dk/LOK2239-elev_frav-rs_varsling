                          </ActivityAction.Argument>
                          <Sequence DisplayName="Report student error" sap2010:WorkflowViewState.IdRef="Sequence_2">
                            <ui:LogMessage DisplayName="Log student processing error" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Error" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; (&quot;Student &quot; &amp; studentRow(&quot;StudentId&quot;).ToString() &amp; &quot; in class &quot; &amp; in_Class.Name &amp; &quot; failed: &quot; &amp; studentError.ToString())]" />
                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="LOK2239.Messages.Add(&quot;Student &quot; &amp; in_Id &amp; &quot; in class &quot; &amp; in_ClassName &amp; &quot; failed: &quot; &amp; in_Error.Message)" DisplayName="Record student error and continue" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
                              <ui:InvokeCode.Arguments>
                                <InArgument x:TypeArguments="x:String" x:Key="in_Id">[studentRow("StudentId").ToString()]</InArgument>
                                <InArgument x:TypeArguments="x:String" x:Key="in_ClassName">[in_Subject.ShortName &amp; &quot;/&quot; &amp; in_Class.Name]</InArgument>
                                <InArgument x:TypeArguments="s:Exception" x:Key="in_Error">[studentError]</InArgument>
                              </ui:InvokeCode.Arguments>
                            </ui:InvokeCode>
                            <Assign DisplayName="Count failed students" sap2010:WorkflowViewState.IdRef="Assign_3">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">[errorCount]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">[errorCount + 1]</InArgument>
                              </Assign.Value>
                            </Assign>
                          </Sequence>
                        </ActivityAction>
                      </Catch>
                    </TryCatch.Catches>
                  <TryCatch.Finally><Sequence DisplayName="Log student processing end" sap2010:WorkflowViewState.IdRef="Sequence_7"><ui:LogMessage DisplayName="Log student processing end" Level="Info" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; &quot;END Student &quot; &amp; studentRow(&quot;StudentId&quot;).ToString() &amp; &quot; - &quot; &amp; studentRow(&quot;StudentName&quot;).ToString()]" sap2010:WorkflowViewState.IdRef="LogMessage_6" /></Sequence></TryCatch.Finally></TryCatch>
                </Sequence>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
          <ui:LogMessage DisplayName="Log detailed student processing totals" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Info" Message="[&quot;[Subject &quot; &amp; in_Subject.ShortName &amp; &quot; - &quot; &amp; in_Subject.LongName &amp; &quot; | Class &quot; &amp; in_Class.Name &amp; &quot; (&quot; &amp; in_Class.Id &amp; &quot;)] &quot; &amp; (&quot;Class &quot; &amp; in_Class.Name &amp; &quot;: &quot; &amp; studentRows.Rows.Count.ToString() &amp; &quot; students total; &quot; &amp; savedCount.ToString() &amp; &quot; written to disk (new or repeat violation). Student errors: &quot; &amp; errorCount.ToString() &amp; &quot;.&quot;)]" />
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>