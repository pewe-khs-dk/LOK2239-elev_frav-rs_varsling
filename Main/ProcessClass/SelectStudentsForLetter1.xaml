    <ui:LogMessage DisplayName="Log total absence evaluation" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Checking Opgjort Procent since the first module for class &quot; &amp; in_Class.Name &amp; &quot;; selecting students strictly above 25%.&quot;]" />
    <ui:InvokeCode DisplayName="Count all extracted students" Language="VBNet" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Code="out_Count = 0&#xA;If in_Table Is Nothing OrElse in_Table.Rows.Count = 0 Then Return&#xA;If Not in_Table.Columns.Contains(&quot;StudentName&quot;) OrElse Not in_Table.Columns.Contains(&quot;StudentUrl&quot;) Then Throw New InvalidOperationException(&quot;Absence extraction is missing student identity columns.&quot;)&#xA;Dim identities As New System.Collections.Generic.HashSet(Of String)(StringComparer.Ordinal)&#xA;For Each row As System.Data.DataRow In in_Table.Rows&#xA;    Dim name = row(&quot;StudentName&quot;).ToString().Trim()&#xA;    Dim url = System.Net.WebUtility.HtmlDecode(row(&quot;StudentUrl&quot;).ToString()).Trim()&#xA;    If name.Length = 0 AndAlso url.Length = 0 Then Continue For&#xA;    Dim id = System.Text.RegularExpressions.Regex.Match(url, &quot;[?&amp;]elevid=(\d+)(&amp;|$)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;    identities.Add(If(id.Success, &quot;id:&quot; &amp; id.Groups(1).Value, &quot;name:&quot; &amp; name &amp; &quot;|url:&quot; &amp; url))&#xA;Next&#xA;out_Count = identities.Count">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Table">[in_AbsenceTable]</InArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_Count">[totalStudentCount]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log extracted student totals" Level="Info" Message="[&quot;Class &quot; &amp; in_Class.Name &amp; &quot;: extracted &quot; &amp; If(in_AbsenceTable Is Nothing, 0, in_AbsenceTable.Rows.Count).ToString() &amp; &quot; table rows containing &quot; &amp; totalStudentCount.ToString() &amp; &quot; students.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_5" />
    <ui:InvokeCode Code="If in_Class Is Nothing Then Throw New ArgumentNullException(NameOf(in_Class))&#xA;Dim selected As New System.Collections.Generic.List(Of LOK2239.ClassStudent)()&#xA;out_StudentErrors = New System.Collections.Generic.List(Of Exception)()&#xA;If in_Table Is Nothing OrElse in_Table.Rows.Count = 0 Then&#xA;    out_Students = selected&#xA;    Return&#xA;End If&#xA;For Each columnName As String In New String() {&quot;StudentName&quot;, &quot;StudentUrl&quot;, &quot;OpgjortProcent&quot;, &quot;OpgjortModuler&quot;}&#xA;    If Not in_Table.Columns.Contains(columnName) Then Throw New InvalidOperationException(&quot;Absence extraction is missing column &quot; &amp; columnName &amp; &quot; for class &quot; &amp; in_Class.Name)&#xA;Next&#xA;Dim seen As New System.Collections.Generic.HashSet(Of String)(StringComparer.Ordinal)&#xA;For Each row As System.Data.DataRow In in_Table.Rows&#xA;  Dim studentLabel As String = &quot;(unknown)&quot;&#xA;  Try&#xA;    Dim studentUrl = System.Net.WebUtility.HtmlDecode(row(&quot;StudentUrl&quot;).ToString()).Trim()&#xA;    If studentUrl.Length = 0 Then Continue For&#xA;    Dim studentName = System.Net.WebUtility.HtmlDecode(row(&quot;StudentName&quot;).ToString()).Trim()&#xA;    If studentName.Length &gt; 0 Then studentLabel = studentName&#xA;    Dim idMatch = System.Text.RegularExpressions.Regex.Match(studentUrl, &quot;[?&amp;]elevid=(\d+)(&amp;|$)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;    If studentName.Length = 0 OrElse Not idMatch.Success Then Throw New InvalidOperationException(&quot;Invalid student identity in the absence table for class &quot; &amp; in_Class.Name)&#xA;    Dim percentText = row(&quot;OpgjortProcent&quot;).ToString().Replace(&quot;%&quot;, &quot;&quot;).Trim()&#xA;    Dim modulesText = row(&quot;OpgjortModuler&quot;).ToString().Trim()&#xA;    Dim zeroModules = System.Text.RegularExpressions.Regex.IsMatch(modulesText, &quot;/\s*0(?:[,.]0+)?\s*$&quot;)&#xA;    If zeroModules Then Continue For&#xA;    If percentText.Length = 0 OrElse percentText = &quot;-&quot; OrElse percentText = &quot;—&quot; Then&#xA;        If modulesText.Length = 0 Then Continue For&#xA;        Throw New InvalidOperationException(&quot;Missing Opgjort Procent for student &quot; &amp; idMatch.Groups(1).Value &amp; &quot; in class &quot; &amp; in_Class.Name)&#xA;    End If&#xA;    Dim percent As Decimal&#xA;    If Not Decimal.TryParse(percentText.Replace(&quot;,&quot;, &quot;.&quot;), System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, percent) OrElse percent &lt; 0D OrElse percent &gt; 100D Then Throw New InvalidOperationException(&quot;Invalid Opgjort Procent for student &quot; &amp; idMatch.Groups(1).Value &amp; &quot; in class &quot; &amp; in_Class.Name &amp; &quot;: &quot; &amp; percentText)&#xA;    Dim studentId = idMatch.Groups(1).Value&#xA;    If percent &gt; 25D AndAlso seen.Add(studentId) Then selected.Add(New LOK2239.ClassStudent With {.Id = studentId, .Name = studentName, .State = LOK2239.StudentState.Letter1Pending})&#xA;  Catch ex As Exception&#xA;    out_StudentErrors.Add(New Exception(&quot;Student &quot; &amp; studentLabel &amp; &quot; in class &quot; &amp; in_Class.Name &amp; &quot; failed: &quot; &amp; ex.Message, ex))&#xA;  End Try&#xA;Next&#xA;out_Students = selected" ContinueOnError="False" DisplayName="Create class students with Letter1Pending" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
