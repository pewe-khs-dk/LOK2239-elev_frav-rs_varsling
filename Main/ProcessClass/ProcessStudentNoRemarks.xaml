<Sequence DisplayName="Update a NoRemarks student from Opgjort absence" sap2010:WorkflowViewState.IdRef="Sequence_1">
<ui:LogMessage DisplayName="Log Opgjort absence parsing" Level="Info" Message="[&quot;Reading Opgjort Procent and Moduler for student &quot; &amp; in_Student.Id &amp; &quot; in class &quot; &amp; in_ClassShortName &amp; &quot;.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
<ui:InvokeCode DisplayName="Read Opgjort metrics and determine first letter state" Language="VBNet" Code="Dim moduleParts = in_Modules.Split(&quot;/&quot;c)&#xA;If moduleParts.Length &lt;&gt; 2 Then Throw New InvalidOperationException(&quot;Invalid Opgjort Moduler: &quot; &amp; in_Modules)&#xA;Dim moduleCount As Decimal&#xA;If Not Decimal.TryParse(moduleParts(1).Trim().Replace(&quot;,&quot;, &quot;.&quot;), System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, moduleCount) OrElse moduleCount &lt; 0D OrElse moduleCount &gt; Integer.MaxValue OrElse Decimal.Truncate(moduleCount) &lt;&gt; moduleCount Then Throw New InvalidOperationException(&quot;Opgjort module count must be a non-negative integer: &quot; &amp; in_Modules)&#xA;Dim percentText = in_Percent.Replace(&quot;%&quot;, &quot;&quot;).Trim()&#xA;Dim percent As Decimal&#xA;If moduleCount = 0D AndAlso (percentText.Length = 0 OrElse percentText = &quot;-&quot; OrElse percentText = &quot;—&quot;) Then&#xA;    percent = 0D&#xA;ElseIf Not Decimal.TryParse(percentText.Replace(&quot;,&quot;, &quot;.&quot;), System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, percent) OrElse percent &lt; 0D OrElse percent &gt; 100D Then&#xA;    Throw New InvalidOperationException(&quot;Invalid Opgjort Procent: &quot; &amp; in_Percent)&#xA;End If&#xA;in_Student.CurrentPercentage = CSng(percent)&#xA;in_Student.ModuleCountSincePeriodStart = CInt(moduleCount)&#xA;out_Above25 = moduleCount &gt; 0D AndAlso percent &gt; 25D&#xA;If out_Above25 Then in_Student.State = LOK2239.StudentState.Letter1Pending" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
<ui:InvokeCode.Arguments>
<InArgument x:TypeArguments="l:ClassStudent" x:Key="in_Student">[in_Student]</InArgument>
<InArgument x:TypeArguments="x:String" x:Key="in_Percent">[in_OpgjortProcent]</InArgument>
<InArgument x:TypeArguments="x:String" x:Key="in_Modules">[in_OpgjortModuler]</InArgument>
<OutArgument x:TypeArguments="x:Boolean" x:Key="out_Above25">[out_Above25]</OutArgument>
</ui:InvokeCode.Arguments>
</ui:InvokeCode>
<ui:LogMessage DisplayName="Log updated absence metrics" Level="Info" Message="[&quot;Student &quot; &amp; in_Student.Id &amp; &quot;: Opgjort absence &quot; &amp; in_Student.CurrentPercentage.ToString() &amp; &quot;%, module count &quot; &amp; in_Student.ModuleCountSincePeriodStart.ToString() &amp; &quot;, state &quot; &amp; in_Student.State.ToString() &amp; &quot;.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
