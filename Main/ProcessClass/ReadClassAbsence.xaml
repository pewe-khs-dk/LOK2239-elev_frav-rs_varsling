            <ui:InvokeCode ContinueOnError="{x:Null}" Code="out_Entries = New System.Collections.Generic.List(Of LOK2239.ClassAbsenceTableEntry)()&#xA;If in_Table Is Nothing Then Return&#xA;If in_Table.Rows.Count &gt; 0 Then&#xA;    For Each name As String In New String() {&quot;StudentName&quot;, &quot;StudentUrl&quot;, &quot;PeriodeProcent&quot;, &quot;PeriodeModuler&quot;, &quot;OpgjortProcent&quot;, &quot;OpgjortModuler&quot;}&#xA;        If Not in_Table.Columns.Contains(name) Then Throw New InvalidOperationException(&quot;Absence extraction is missing column &quot; &amp; name)&#xA;    Next&#xA;End If&#xA;For Each prop As System.Reflection.PropertyInfo In GetType(LOK2239.ClassAbsenceTableEntry).GetProperties()&#xA;    If Not in_Table.Columns.Contains(prop.Name) Then&#xA;        in_Table.Columns.Add(prop.Name, prop.PropertyType)&#xA;    ElseIf in_Table.Columns(prop.Name).DataType &lt;&gt; prop.PropertyType Then&#xA;        Throw New InvalidOperationException(&quot;Absence column &quot; &amp; prop.Name &amp; &quot; has an unexpected data type.&quot;)&#xA;    End If&#xA;Next&#xA;If in_Table.Rows.Count = 0 Then Return&#xA;Dim classUri As New Uri(in_ClassAbsenceUrl, UriKind.Absolute)&#xA;Dim parseNumber As Func(Of String, String, Single) =&#xA;    Function(raw As String, label As String) As Single&#xA;        Dim value As Decimal&#xA;        If Not Decimal.TryParse(raw.Trim().Replace(&quot;,&quot;, &quot;.&quot;), System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, value) OrElse value &lt; 0D Then Throw New FormatException(&quot;Invalid &quot; &amp; label &amp; &quot;: &quot; &amp; raw)&#xA;        Return CSng(value)&#xA;    End Function&#xA;Dim parseModules As Func(Of String, String, Single()) =&#xA;    Function(raw As String, label As String) As Single()&#xA;        Dim clean = raw.Trim()&#xA;        If clean.Length = 0 OrElse clean = &quot;-&quot; OrElse clean = &quot;—&quot; Then Return New Single() {0F, 0F}&#xA;        Dim parts = clean.Split(&quot;/&quot;c)&#xA;        If parts.Length &lt;&gt; 2 Then Throw New FormatException(&quot;Invalid &quot; &amp; label &amp; &quot;, expected absence/total: &quot; &amp; raw)&#xA;        Return New Single() {parseNumber(parts(0), label &amp; &quot; absent modules&quot;), parseNumber(parts(1), label &amp; &quot; total modules&quot;)}&#xA;    End Function&#xA;Dim parsePercent As Func(Of String, Single, String, Single) =&#xA;    Function(raw As String, moduleTotal As Single, label As String) As Single&#xA;        Dim clean = raw.Replace(&quot;%&quot;, &quot;&quot;).Trim()&#xA;        If moduleTotal = 0F AndAlso (clean.Length = 0 OrElse clean = &quot;-&quot; OrElse clean = &quot;—&quot;) Then Return 0F&#xA;        Dim value = parseNumber(clean, label)&#xA;        If value &gt; 100F Then Throw New FormatException(&quot;Invalid &quot; &amp; label &amp; &quot;: &quot; &amp; raw)&#xA;        Return value&#xA;    End Function&#xA;Dim seen As New System.Collections.Generic.HashSet(Of String)(StringComparer.Ordinal)&#xA;For Each row As System.Data.DataRow In in_Table.Rows&#xA;    Dim rawUrl = System.Net.WebUtility.HtmlDecode(row(&quot;StudentUrl&quot;).ToString()).Trim()&#xA;    If rawUrl.Length = 0 Then Continue For&#xA;    Dim studentLabel = System.Net.WebUtility.HtmlDecode(row(&quot;StudentName&quot;).ToString()).Trim()&#xA;    Try&#xA;        Dim studentUri As New Uri(classUri, rawUrl)&#xA;        Dim idMatch = System.Text.RegularExpressions.Regex.Match(studentUri.Query, &quot;[?&amp;]elevid=(\d+)(&amp;|$)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;        If studentLabel.Length = 0 OrElse Not idMatch.Success Then Throw New InvalidOperationException(&quot;Student identity is missing or invalid.&quot;)&#xA;        Dim periode = parseModules(row(&quot;PeriodeModuler&quot;).ToString(), &quot;Periode Moduler&quot;)&#xA;        Dim opgjort = parseModules(row(&quot;OpgjortModuler&quot;).ToString(), &quot;Opgjort Moduler&quot;)&#xA;        Dim entry As New LOK2239.ClassAbsenceTableEntry With {&#xA;            .StudentId = idMatch.Groups(1).Value,&#xA;            .StudentName = studentLabel,&#xA;            .StudentUrl = studentUri.AbsoluteUri,&#xA;            .ClassAbsenceUrl = classUri.AbsoluteUri,&#xA;            .PeriodeAbsencePercentage = parsePercent(row(&quot;PeriodeProcent&quot;).ToString(), periode(1), &quot;Periode Procent&quot;),&#xA;            .PeriodeAbsenceModuleCount = periode(0),&#xA;            .PeriodeModuleCount = periode(1),&#xA;            .OpgjortAbsencePercentage = parsePercent(row(&quot;OpgjortProcent&quot;).ToString(), opgjort(1), &quot;Opgjort Procent&quot;),&#xA;            .OpgjortAbsenceModuleCount = opgjort(0),&#xA;            .OpgjortModuleCount = opgjort(1)&#xA;        }&#xA;        For Each prop As System.Reflection.PropertyInfo In GetType(LOK2239.ClassAbsenceTableEntry).GetProperties()&#xA;            row(prop.Name) = prop.GetValue(entry)&#xA;        Next&#xA;        If seen.Add(entry.StudentId) Then out_Entries.Add(entry)&#xA;    Catch ex As Exception&#xA;        Throw New InvalidOperationException(&quot;Could not map absence for student &quot; &amp; studentLabel &amp; &quot; on &quot; &amp; in_ClassAbsenceUrl &amp; &quot;: &quot; &amp; ex.Message, ex)&#xA;    End Try&#xA;Next" DisplayName="Populate absence properties and local typed entries" sap:VirtualizedContainerService.HintSize="416,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
