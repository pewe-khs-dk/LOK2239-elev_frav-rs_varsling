tch.Groups(1).Value&#xA;    If seen.Add(subjectId) Then out_Subjects.Add(New LOK2239.Subject With {.Id = subjectId, .ShortName = shortName, .LongName = longName, .Url = link.AbsoluteUri})&#xA;Next" ContinueOnError="False" DisplayName="Create subjects from extracted rows" sap:VirtualizedContainerService.HintSize="488,403" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
